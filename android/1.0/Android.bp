cc_library_shared {
    name: "android.hardware.gnss@1.0-impl-qti",
    vendor: true,
    relative_install_path: "hw",
    srcs: [
        "AGnss.cpp",
        "Gnss.cpp",
        "GnssBatching.cpp",
        "GnssGeofencing.cpp",
        "GnssMeasurement.cpp",
        "GnssNi.cpp",
        "GnssConfiguration.cpp",
        "GnssDebug.cpp",
        "AGnssRil.cpp",
        "location_api/LocationUtil.cpp",
        "location_api/GnssAPIClient.cpp",
        "location_api/GeofenceAPIClient.cpp",
        "location_api/BatchingAPIClient.cpp",
        "location_api/MeasurementAPIClient.cpp",
    ],

    header_libs: [
        "libgps.utils_headers",
        "libloc_core_headers",
        "libloc_pla_headers",
        "liblocation_api_headers",
        "liblocbatterylistener_headers",
    ],

    shared_libs: [
        "liblog",
        "libhidlbase",
        "libbinder_ndk",
        "libcutils",
        "libutils",
        "android.hardware.gnss@1.0",
        "android.hardware.health-V1-ndk",
        "android.hardware.health@1.0",
        "android.hardware.health@2.0",
        "android.hardware.health@2.1",
        "android.hardware.power@1.2",
        "libbase",
        "libloc_core",
        "libgps.utils",
        "libdl",
        "liblocation_api",
    ],

    static_libs: [
        "liblocbatterylistener",
        "libhealthhalutils",
    ],

    local_include_dirs: [
        "$(LOCAL_PATH)/location_api",
    ],

    cflags: GNSS_CFLAGS,
}

cc_binary {
    name: "android.hardware.gnss@1.0-service-qti",
    vendor: true,
    relative_install_path: "hw",
    init_rc: ["android.hardware.gnss@1.0-service-qti.rc"],
    vintf_fragments: ["android.hardware.gnss@1.0-service-qti.xml"],
    srcs: [
        "service.cpp",
    ],

    header_libs: [
        "libgps.utils_headers",
        "libloc_core_headers",
        "libloc_pla_headers",
        "liblocation_api_headers",
    ],

    shared_libs: [
        "liblog",
        "libcutils",
        "libdl",
        "libbase",
        "libutils",
        "libgps.utils",
        "libqti_vndfwk_detect_vendor",
        "libhidlbase",
        "android.hardware.gnss@1.0",
    ],

    cflags: GNSS_CFLAGS,
}
